# ${VAR}s are filled in at container start from environment variables.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Without this, any add_header inside a location silently drops all the headers below.
    add_header_inherit merge;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-ancestors 'none'" always;

    # Same-origin API: the browser calls /api/..., nginx forwards it inside the cluster.
    # Week 3 points this at the API gateway instead of directly at catalog-service.
    location /api/ {
        # Resolve the upstream per request (not once at startup), so nginx starts even if
        # catalog-service doesn't exist yet and follows it when its IP changes.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $upstream ${CATALOG_URL};
        proxy_pass $upstream;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Built files have content hashes in their names, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Client-side routes (/media/123, /rentals) all serve index.html; React Router takes over.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}

# Probe endpoint on the management port, like the Spring services' actuator.
server {
    listen 8081;
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
