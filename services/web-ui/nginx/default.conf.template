# ${VAR}s are filled in at container start from environment variables.
# In docker-compose this nginx is the single front door (http://localhost:3000). In Kubernetes,
# Envoy Gateway routes these paths before they get here, so only "/" is served by this file.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Without this, any add_header inside a location silently drops all the headers below.
    add_header_inherit merge;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-ancestors 'none'" always;

    # Resolve upstreams per request, so nginx starts even before the other containers exist.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Keep the browser's host (localhost:3000) so redirects and cookies point back at it.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Keycloak and the OAuth redirects send large cookies/headers; the 4k default causes 502s.
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;

    # API calls and the login/logout handshake go to the gateway (backend-for-frontend).
    location ~ ^/(api|oauth2|login|logout)(/|$) {
        set $gateway ${GATEWAY_URL};
        proxy_pass $gateway;
    }

    # Keycloak's own pages set their own security headers; ours would conflict with them.
    location /auth/ {
        add_header_inherit off;
        set $keycloak ${KEYCLOAK_URL};
        proxy_pass $keycloak;
    }

    # Built files have content hashes in their names, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Client-side routes (/media/123, /rentals) all serve index.html; React Router takes over.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}

# Probe endpoint on the management port, like the Spring services' actuator.
server {
    listen 8081;
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
